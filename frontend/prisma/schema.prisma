// hustl. data model — mirrors the service boundaries in the architecture doc
// (user / deal / payment / creator-data / notification). SQLite for zero-setup
// local dev; switch `provider` to "postgresql" for production (no enums or
// scalar lists are used, so the schema is portable as-is).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── User service ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  image        String?
  role         String? // BRAND | CREATOR | ADMIN — null until onboarding
  kycVerified  Boolean  @default(false)
  createdAt    DateTime @default(now())

  creator       CreatorProfile?
  brand         BrandProfile?
  messages      Message[]
  notifications Notification[]
  events        DealEvent[]
  disputes      Dispute[]
  reviewsGiven  Review[]        @relation("ReviewAuthor")
  reviewsGot    Review[]        @relation("ReviewSubject")
}

model CreatorProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle           String    @unique
  headline         String    @default("")
  bio              String    @default("")
  location         String    @default("")
  avatarUrl        String?
  niches           Json      @default("[]") // string[]
  platforms        Json      @default("[]") // { platform, handle, followers, engagementRate, avgViews }[]
  rateCard         Json      @default("[]") // { deliverable, price }[]
  portfolio        Json      @default("[]") // { title, url, brand? }[]
  languages        Json      @default("[]")
  followers        Int       @default(0)
  engagementRate   Float     @default(0)
  followerGrowth30d Float    @default(0)
  // Creator scoring engine (AI module 2) + fraud detection (module 4)
  trustScore       Int       @default(50)
  reliabilityScore Int       @default(50)
  nicheAuthority   Int       @default(50)
  authenticityScore Int      @default(80)
  fraudFlags       Json      @default("[]")
  embedding        Json? // number[] (384-dim)
  completedDeals   Int       @default(0)
  avgRating        Float     @default(0)
  responseHours    Float     @default(24)
  onTimeRate       Float     @default(1)
  available        Boolean   @default(true)
  verified         Boolean   @default(false)
  socialsConnected Boolean   @default(false)
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  applications Application[]
  deals        Deal[]
  savedBy      SavedCreator[]
}

model BrandProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String   @unique
  companyName String
  logoUrl     String?
  website     String   @default("")
  industry    String   @default("")
  description String   @default("")
  location    String   @default("")
  size        String   @default("")
  plan        String   @default("STARTER") // STARTER | GROWTH | ENTERPRISE
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  briefs Brief[]
  deals  Deal[]
  saved  SavedCreator[]
}

model SavedCreator {
  brandId   String
  creatorId String
  brand     BrandProfile   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([brandId, creatorId])
}

// ─── Deal service ────────────────────────────────────────────────────────────

model Brief {
  id               String   @id @default(cuid())
  brandId          String
  brand            BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title            String
  description      String
  niche            String   @default("")
  platforms        Json     @default("[]") // string[]
  deliverables     Json     @default("[]") // { type, quantity }[]
  minFollowers     Int      @default(0)
  minEngagement    Float    @default(0)
  budgetPerCreator Int      @default(0) // INR
  creatorsNeeded   Int      @default(1)
  location         String   @default("")
  timeline         String   @default("")
  audience         String   @default("")
  status           String   @default("DRAFT") // DRAFT | PUBLISHED | CLOSED
  parsed           Json? // brief parser output incl. confidence
  embedding        Json?
  deadline         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applications Application[]
  deals        Deal[]
}

model Application {
  id            String   @id @default(cuid())
  briefId       String
  brief         Brief    @relation(fields: [briefId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  pitch         String
  proposedRate  Int
  status        String   @default("APPLIED") // APPLIED | SHORTLISTED | OFFERED | REJECTED | WITHDRAWN
  matchScore    Int      @default(0)
  matchReasons  Json     @default("[]")
  disqualifiers Json     @default("[]")
  createdAt     DateTime @default(now())

  @@unique([briefId, creatorId])
}

model Deal {
  id               String    @id @default(cuid())
  title            String
  briefId          String?
  brief            Brief?    @relation(fields: [briefId], references: [id], onDelete: SetNull)
  applicationId    String?
  brandId          String
  brand            BrandProfile   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creatorId        String
  creator          CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  amount           Int // INR, creator-facing deal value
  currency         String    @default("INR")
  paymentMode      String    @default("MILESTONES") // COMPLETION | UPFRONT | MILESTONES
  status           String    @default("OFFER_SENT")
  awaitingParty    String    @default("CREATOR") // BRAND | CREATOR — whose move in negotiation
  negotiationRound Int       @default(0)
  deliverables     String    @default("")
  dueDate          DateTime?
  brandFeePct      Float     @default(0.06)
  creatorFeePct    Float     @default(0.05)
  processingFeePct Float     @default(0.02)
  brandSignedAt    DateTime?
  creatorSignedAt  DateTime?
  fundedAt         DateTime?
  completedAt      DateTime?
  holdUntil        DateTime? // fraud hold on high-risk deals
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  milestones   Milestone[]
  events       DealEvent[]
  messages     Message[]
  transactions Transaction[]
  disputes     Dispute[]
  reviews      Review[]
}

model Milestone {
  id             String    @id @default(cuid())
  dealId         String
  deal           Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  order          Int
  title          String
  percent        Int
  amount         Int
  dueDate        DateTime?
  status         String    @default("PENDING") // PENDING | SUBMITTED | REVISION_REQUESTED | APPROVED | RELEASED | DISPUTED
  submissionUrl  String?
  submissionNote String?
  revisionNote   String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  releasedAt     DateTime?

  transactions Transaction[]
}

// Append-only audit log of every state transition (the Kafka event analogue).
model DealEvent {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type       String
  fromStatus String?
  toStatus   String?
  note       String?
  createdAt  DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Dispute {
  id          String    @id @default(cuid())
  dealId      String
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  milestoneId String?
  raisedById  String
  raisedBy    User      @relation(fields: [raisedById], references: [id], onDelete: Cascade)
  reason      String
  status      String    @default("OPEN") // OPEN | RESOLVED
  resolution  String? // RELEASE_TO_CREATOR | REFUND_TO_BRAND | SPLIT
  adminNote   String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model Review {
  id            String   @id @default(cuid())
  dealId        String
  deal          Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectUserId String
  subject       User     @relation("ReviewSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String   @default("")
  createdAt     DateTime @default(now())

  @@unique([dealId, authorId])
}

// ─── Payment service ─────────────────────────────────────────────────────────

// Double-entry-style escrow ledger. Provider adapters (Stripe Connect /
// Razorpay Route) write `reference`; test mode uses generated references.
model Transaction {
  id          String     @id @default(cuid())
  dealId      String
  deal        Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  type        String // ESCROW_FUND | BRAND_FEE | PROCESSING_FEE | RELEASE | CREATOR_FEE | REFUND
  amount      Int
  status      String     @default("SUCCEEDED") // PENDING | SUCCEEDED | FROZEN | FAILED
  provider    String     @default("test")
  reference   String
  createdAt   DateTime   @default(now())
}

// ─── Notification service ────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @default("")
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
