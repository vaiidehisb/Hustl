# PostgreSQL (shared hustl database). Any Prisma ?schema= param is stripped.
DATABASE_URL=postgresql://hustl@localhost:5433/hustl
# Must match INTERNAL_SERVICE_TOKEN in backend/.env — callers send it as `x-internal-token`.
INTERNAL_SERVICE_TOKEN=change-me

# sentence-transformers (all-MiniLM-L6-v2, needs torch) | hashing (lightweight fallback)
EMBEDDING_BACKEND=hashing

# Brief parser: Claude when set, deterministic rules otherwise.
ANTHROPIC_API_KEY=
BRIEF_PARSER_MODEL=claude-sonnet-4-6

# Celery broker/result backend. Unset → batch endpoints run inline.
REDIS_URL=

# Scoring model: v1-formula | v2-xgboost (requires MLflow registry)
SCORING_MODEL=v1-formula
MLFLOW_TRACKING_URI=
MLFLOW_SCORING_MODEL_URI=models:/creator-scoring/Production

# Tuning
MATCH_CANDIDATE_POOL=200
FRAUD_MIN_POPULATION=50
FRAUD_HIGH_VALUE_DEAL_AMOUNT=50000
FRAUD_FAILED_PAYMENT_THRESHOLD=3
RUN_MIGRATIONS_ON_STARTUP=true

# Tests only
TEST_DATABASE_URL=postgresql://hustl@localhost:5433/hustl_test
