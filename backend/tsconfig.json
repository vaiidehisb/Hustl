{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@hustl/common": ["packages/common/src/index.ts"],
      "@hustl/db": ["packages/db/src/index.ts"],
      "@hustl/contracts": ["packages/contracts/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "services/*/src/**/*.ts", "services/*/test/**/*.ts", "packages/*/test/**/*.ts"]
}
