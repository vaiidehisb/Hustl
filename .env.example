# hustl. — environment reference. Copy to `.env` (docker compose) and to
# `backend/.env`, `frontend/.env.local`, `ai-backend/.env` for local runs.
# Never commit real values.

# ── Required (all environments) ─────────────────────────────────────────────
DATABASE_URL=postgresql://hustl:hustl@localhost:5432/hustl?schema=public
# ≥32 random chars, shared by user-service (signs) and every service (verifies)
JWT_SECRET=
# ≥16 random chars, shared by backend services + AI backend for internal calls
INTERNAL_SERVICE_TOKEN=
# Frontend session encryption (NextAuth)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Where the Next.js server reaches the API gateway (server-side only)
API_GATEWAY_URL=http://localhost:4000
# Public URL used in emails / payment redirects
PUBLIC_APP_URL=http://localhost:3000

# ── Infrastructure (optional locally — services fall back and report it) ────
# Kafka event bus; unset → transactional outbox polling
KAFKA_BROKERS=
# Socket.io scale-out + AI Celery broker/cache
REDIS_URL=
# Search indices; unset → PostgreSQL search engine
ELASTICSEARCH_URL=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300

# Service discovery (defaults to localhost:<port>)
USER_SERVICE_URL=http://localhost:4001
DEAL_SERVICE_URL=http://localhost:4002
PAYMENT_SERVICE_URL=http://localhost:4003
CREATOR_SERVICE_URL=http://localhost:4004
SEARCH_SERVICE_URL=http://localhost:4005
NOTIFICATION_SERVICE_URL=http://localhost:4006
ANALYTICS_SERVICE_URL=http://localhost:4007
MEDIA_SERVICE_URL=http://localhost:4008
AI_SERVICE_URL=http://localhost:8000

# ── Payments (third-party) ──────────────────────────────────────────────────
# stripe | razorpay | test   (test is refused when NODE_ENV=production)
PAYMENTS_PROVIDER=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Social data (third-party) ───────────────────────────────────────────────
PHYLLO_CLIENT_ID=
PHYLLO_CLIENT_SECRET=
# sandbox | staging | production
PHYLLO_ENVIRONMENT=sandbox
PHYLLO_WEBHOOK_SECRET=

# ── AI (third-party) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
BRIEF_PARSER_MODEL=claude-sonnet-4-6
# sentence-transformers (production) | hashing (lightweight local fallback)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MLFLOW_TRACKING_URI=

# ── Auth (third-party) ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (third-party) ─────────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=hello@hustl.app

# ── Media storage (production) ──────────────────────────────────────────────
# s3 | local
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.local/storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
