# ─── Gateway (server-side only; the browser never sees service or AI URLs) ───
# Docker compose: http://gateway:4000
API_GATEWAY_URL=http://localhost:4000

# Socket.io through the gateway (path /socket.io). Must be reachable from the browser.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=

# Optional: Google sign-in (the button hides when unset). user-service needs the same GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Legacy (removed after the portal pages move onto lib/api) ────────────────
# Old brand/creator/admin pages still read the database through Prisma.
DATABASE_URL=
